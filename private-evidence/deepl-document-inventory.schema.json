{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "deepl-document-inventory.schema.json",
  "title": "DeepL document inventory",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "scope",
    "scan_summary",
    "definitions",
    "documents"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "scope": {
      "type": "object"
    },
    "scan_summary": {
      "type": "object"
    },
    "definitions": {
      "type": "object"
    },
    "documents": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/document"
      }
    }
  },
  "$defs": {
    "claimCoverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact",
        "contribution",
        "lifecycle",
        "outcome"
      ],
      "properties": {
        "artifact": {
          "$ref": "#/$defs/claimStatus"
        },
        "contribution": {
          "$ref": "#/$defs/claimStatus"
        },
        "lifecycle": {
          "$ref": "#/$defs/claimStatus"
        },
        "outcome": {
          "$ref": "#/$defs/claimStatus"
        }
      }
    },
    "claimStatus": {
      "enum": [
        "verified",
        "supported-but-partial",
        "weak",
        "contradicted",
        "unknown"
      ]
    },
    "document": {
      "type": "object",
      "required": [
        "source_record_id",
        "source_system",
        "canonical_name",
        "title_group_id",
        "custody",
        "origin",
        "privacy",
        "publication_default",
        "claim_coverage",
        "date_range",
        "locators"
      ],
      "properties": {
        "source_record_id": {
          "type": "string",
          "minLength": 1
        },
        "source_system": {
          "enum": [
            "chatgpt",
            "claude-projects",
            "claude-conversations"
          ]
        },
        "canonical_name": {
          "type": "string",
          "minLength": 1
        },
        "alternate_names": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "title_group_id": {
          "type": "string",
          "pattern": "^title-[a-f0-9]{12}$"
        },
        "exact_content_group_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "exact_content_group_size": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "custody": {
          "enum": [
            "original-binary",
            "retained-full",
            "retained-partial",
            "metadata-only"
          ]
        },
        "origin": {
          "enum": [
            "public-product-source",
            "internal-organizational-record",
            "mason-authored",
            "assistant-synthesis",
            "ai-assisted-working-artifact",
            "mixed",
            "unknown"
          ]
        },
        "privacy": {
          "enum": [
            "public",
            "internal-restricted",
            "unknown-private"
          ]
        },
        "publication_default": {
          "enum": [
            "allow",
            "deny"
          ]
        },
        "claim_coverage": {
          "$ref": "#/$defs/claimCoverage"
        },
        "retained_text": {
          "type": [
            "object",
            "null"
          ]
        },
        "binary": {
          "type": [
            "object",
            "null"
          ]
        },
        "assistant_derivatives": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "attachment_metadata": {
          "type": "object"
        },
        "recovered_repo_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "date_range": {
          "type": "object",
          "required": [
            "first_seen",
            "last_seen"
          ]
        },
        "locators": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object"
          }
        }
      }
    }
  }
}
